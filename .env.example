# Copy to .env (gitignored) for docker compose, or pass these as variables of the shell (they win
# over the .env). The secrets have no default.
# Root key: logs in to the console and signs S3 requests (mc wants a secret of 8+ characters)
FEATHER_ACCESS=
FEATHER_SECRET=
# Long random strings, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Encrypts the secrets of the access keys: changing it makes them unreadable
KEYS_ENCRYPTION_SECRET=

ADMIN_PREFIX=_admin
# The service as the browser sees it (the console calls it from the browser)
SERVICE_URL=http://localhost:8080
# Optional: scheme, host and port of the presigned URLs (otherwise the Host of the request)
PUBLIC_URL=
